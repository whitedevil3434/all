@import "tailwindcss";

@theme {
  /* Premium Soft Neumorphic Palette */
  --color-neo-bg: #F4F4F5; /* Slightly cooler, premium light gray */
  --color-canvas-dot: rgba(0, 0, 0, 0.04);
  
  /* Refined, Elegant Neumorphic Shadows (Less muddy, more crisp) */
  --shadow-neo-up: 4px 4px 10px rgba(163, 177, 198, 0.4), -4px -4px 10px rgba(255, 255, 255, 0.8);
  --shadow-neo-down: inset 4px 4px 8px rgba(163, 177, 198, 0.4), inset -4px -4px 8px rgba(255, 255, 255, 0.8);
  
  --shadow-neo-up-sm: 2px 2px 5px rgba(163, 177, 198, 0.3), -2px -2px 5px rgba(255, 255, 255, 0.9);
  --shadow-neo-down-sm: inset 2px 2px 4px rgba(163, 177, 198, 0.4), inset -2px -2px 4px rgba(255, 255, 255, 0.9);
  
  --shadow-neo-up-md: 6px 6px 14px rgba(163, 177, 198, 0.45), -6px -6px 14px rgba(255, 255, 255, 0.8);
  --shadow-neo-down-md: inset 6px 6px 12px rgba(163, 177, 198, 0.5), inset -6px -6px 12px rgba(255, 255, 255, 0.8);
  
  --shadow-neo-up-lg: 10px 10px 20px rgba(163, 177, 198, 0.45), -10px -10px 20px rgba(255, 255, 255, 0.9);
  --shadow-neo-down-lg: inset 10px 10px 20px rgba(163, 177, 198, 0.5), inset -10px -10px 20px rgba(255, 255, 255, 0.9);
  
  --shadow-neo-up-xl: 14px 14px 28px rgba(163, 177, 198, 0.4), -14px -14px 28px rgba(255, 255, 255, 0.9);
}  
  /* Flowing energy for active causal threads */
  @keyframes flow-energy {
    0% { background-position: 200% 50%; }
    100% { background-position: 0% 50%; }
  }
  .thread-flowing {
    background-size: 200% 200%;
    background-image: linear-gradient(90deg, 
      rgba(251,191,36, 0.4) 0%, 
      rgba(251,191,36, 1) 50%, 
      rgba(251,191,36, 0.4) 100%
    );
    animation: flow-energy 1.5s linear infinite;
  }

  /* The Reality Void Effect for UNKNOWN dependencies */
  @keyframes void-pulse {
    0% { box-shadow: inset 0 2px 10px rgba(0,0,0,0.02); }
    50% { box-shadow: inset 0 5px 20px rgba(0,0,0,0.08); }
    100% { box-shadow: inset 0 2px 10px rgba(0,0,0,0.02); }
  }
  .reality-void {
    animation: void-pulse 4s ease-in-out infinite;
    background: repeating-linear-gradient(
      -45deg,
      rgba(0,0,0,0.01),
      rgba(0,0,0,0.01) 8px,
      rgba(0,0,0,0.03) 8px,
      rgba(0,0,0,0.03) 16px
    );
  }

  /* Cinematic Focus Engine using modern CSS :has() */
  /* When ANY node is focused/expanded, dim and blur the unfocused ones */
  .surface-container:has(.node-is-focused) .node-wrapper:not(.node-is-focused) {
     opacity: 0.5;
     filter: grayscale(20%);
     transform: scale(0.98);
  }
  
  /* Ensure parent wrappers of focused nodes don't dim */
  .surface-container:has(.node-is-focused) .node-wrapper:has(.node-is-focused) {
     opacity: 1;
     filter: none;
     transform: scale(1);
  }

  .node-wrapper {
     transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

@layer base {
  body {
    background-color: var(--color-neo-bg);
    color: #2D3748;
  }
}

@layer utilities {
  .bg-dot-grid {
    background-image: radial-gradient(var(--color-canvas-dot) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  
  .causal-thread-v {
    position: absolute;
    left: -20px;
    top: -12px;
    bottom: 24px;
    width: 0px;
    border-left: 2px solid #E4E4E7;
  }
  
  .causal-thread-h {
    position: absolute;
    left: -20px;
    top: 24px;
    width: 20px;
    height: 0px;
    border-top: 2px solid #E4E4E7;
  }
  
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
}
